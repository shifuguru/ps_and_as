# Game server URL for native apps (Expo Go / dev builds).
# - Web dev ignores this and uses the Metro proxy automatically.
# - Native dev with Railway/ngrok: set a public https URL — it takes priority over LAN.
# - Native dev with local server: use localhost or omit; Expo LAN host is used automatically.
#
# Railway example (also set the same value as a GitHub Actions repository variable
# for GitHub Pages builds — Settings → Secrets and variables → Actions → Variables):
# EXPO_PUBLIC_SERVER_URL=https://your-production-service.up.railway.app
EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# Google Sign-in (web) — OAuth 2.0 Web client ID from Google Cloud Console.
# Also add as a GitHub Actions variable for Pages builds, and set the same
# value as GOOGLE_CLIENT_ID on Railway so google: stats writes are verified.
# EXPO_PUBLIC_* values are baked into the client bundle — never put private keys,
# HMAC secrets, or Railway tokens in EXPO_PUBLIC_* variables.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Railway-only (server) secrets — set in the Railway dashboard, not in the web build:
#   GOOGLE_CLIENT_ID=...          # ID token audience allow-list
#   GOOGLE_SESSION_SECRET=...     # HMAC for psas1.* session tokens (required in prod)
# Do not reuse the public web client ID as GOOGLE_SESSION_SECRET.
# Rotate GOOGLE_SESSION_SECRET ~every 90 days and after any suspected leak.
# See docs/ops-security-checklist.md and docs/data-inventory.md.

# Optional override for the player-facing privacy page URL (defaults to Pages /privacy.html).
# EXPO_PUBLIC_PRIVACY_URL=https://shifuguru.github.io/ps_and_as/privacy.html

# Development game server (deploy-web-dev.yml) — use a separate Railway service
# on the develop branch so testers do not share rooms/state with live players.
# EXPO_PUBLIC_SERVER_URL_DEV=https://your-dev-service.up.railway.app
